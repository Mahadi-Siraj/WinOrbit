<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for hosting classic Windows Media Player's control in remote mode (Services\ClassicMediaPlayer.cs);
         its assemblies load only while that player is open. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <AssemblyName>WinOrbit</AssemblyName>
    <!-- Program.Main answers the agent switch (AI tool hooks) before WPF loads, then starts App as usual. -->
    <StartupObject>WinOrbit.Program</StartupObject>
    <RootNamespace>WinOrbit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\winorbit.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <Product>WinOrbit</Product>
    <Description>Liquid Glass desktop customisation suite for Windows</Description>
    <Copyright>Local-first. No telemetry.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WFAC010 (renamed WFO0003 in .NET 9) is a Windows Forms analyser asking WinForms apps to set DPI awareness in
         code. This is a WPF app: per-monitor-v2 awareness belongs in app.manifest, where Windows reads it before any code runs. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\winorbit.ico" />
    <!-- Compiled pixel shader (source: the .fx beside it; rebuild with tools\compile-shader.ps1). -->
    <Resource Include="Design\Shaders\LiquidGlass.ps" />
    <None Include="Design\Shaders\LiquidGlass.fx" />
    <InternalsVisibleTo Include="WinOrbit.Tests" />
    <!-- Keep WPF names unambiguous: Windows Forms is used in one file only, fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF 9+ has its own System.Windows.ThemeMode; "ThemeMode" in this project always means WinOrbit's. -->
    <Using Include="WinOrbit.Core.ThemeMode" Alias="ThemeMode" />
  </ItemGroup>

</Project>
