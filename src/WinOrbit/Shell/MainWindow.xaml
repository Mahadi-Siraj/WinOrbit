<Window x:Class="WinOrbit.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:WinOrbit.Design"
        Title="WinOrbit" Width="1180" Height="780" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="Transparent" UseLayoutRounding="True"
        FontFamily="{DynamicResource F.Family}" Foreground="{DynamicResource T.Text}" TextOptions.TextFormattingMode="Ideal"
        Icon="/Assets/winorbit.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Frame">
        <!-- Material: DWM acrylic/mica sits behind everything; when unavailable the wallpaper-sampled glass takes over. -->
        <d:GlassSurface x:Name="FallbackGlass" CornerRadius="0" CastShadow="False" SampleWallpaper="False" Visibility="Collapsed"/>
        <Border x:Name="Tint" Background="{DynamicResource T.WindowTint}"/>
        <Border Background="{DynamicResource T.Wash}" Opacity="0.85"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <Grid Margin="14,14,4,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,4,0,18" WindowChrome.IsHitTestVisibleInChrome="False">
                    <Image Source="/Assets/winorbit.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinOrbit" FontSize="16.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SideSubtitle" Text="Liquid Glass desktop" FontSize="11.5" Foreground="{DynamicResource T.Text3}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Settings search -->
                <Grid Grid.Row="1" Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border CornerRadius="10" Background="{DynamicResource T.Input}" BorderBrush="{DynamicResource T.Stroke}" BorderThickness="1" Padding="10,0,8,0" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource T.Text3}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search settings" FontSize="12.5" Foreground="{DynamicResource T.Text3}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource TextBox.Bare}" FontSize="12.5" VerticalAlignment="Center"
                                     AutomationProperties.Name="Search settings" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey" LostKeyboardFocus="OnSearchLostFocus"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="10" HorizontalOffset="-30" AllowsTransparency="True" StaysOpen="True">
                        <Border Width="340" CornerRadius="14" Padding="6" Background="{DynamicResource T.Popup}" BorderBrush="{DynamicResource T.StrokeStrong}" BorderThickness="1" Margin="0,0,14,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel x:Name="SearchResults"/>
                        </Border>
                    </Popup>
                </Grid>

                <ListBox x:Name="Nav" Grid.Row="2" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNav"
                         AutomationProperties.Name="Sections" KeyboardNavigation.TabNavigation="Once"/>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="OnProfileChip"
                        ToolTip="Switch profile">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource T.AccentSoft}">
                            <TextBlock x:Name="ProfileGlyph" Style="{StaticResource Icon}" Foreground="{DynamicResource T.Accent}" FontSize="14"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PROFILE" Style="{StaticResource Text.Label}" FontSize="10"/>
                            <TextBlock x:Name="ProfileName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource T.Text3}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Content ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Height="44">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimise"/>
                        <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximise"/>
                        <Button Style="{StaticResource Button.Caption}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="22,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="Header" Margin="2,0,24,18">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Display}" FontSize="30"/>
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource PageScroll}">
                        <ContentControl x:Name="PageHost" Margin="0,0,14,28" Focusable="False"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
