<Window x:Class="WinOrbit.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:WinOrbit.Design"
        Title="WinOrbit Island" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="560" Height="420" UseLayoutRounding="True"
        FontFamily="{DynamicResource F.Family}" Foreground="{DynamicResource T.Text}" TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Optional halo in the rim's colours, behind the glass; follows the pill's size and motion -->
        <Border x:Name="PillGlow" UseLayoutRounding="False" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                BorderThickness="3" CornerRadius="19" Opacity="0.85" RenderTransformOrigin="0.5,0"
                Width="{Binding ActualWidth, ElementName=Pill}" Height="{Binding ActualHeight, ElementName=Pill}"
                RenderTransform="{Binding RenderTransform, ElementName=Pill}">
            <Border.Effect>
                <BlurEffect Radius="16" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <!-- Liquid neck between the capsule and its side bubble while they are close: the same blurred wallpaper and
             tint as the glass, so for a moment they look like one drop pulling apart (drawn by IslandWindow.Split.cs). -->
        <Canvas x:Name="Bridge" IsHitTestVisible="False" Visibility="Collapsed">
            <Path x:Name="BridgeBack"/>
            <Path x:Name="BridgeTint"/>
        </Canvas>

        <!-- Side bubble: a short alert while the capsule is busy with music, a call or a timer -->
        <d:GlassSurface x:Name="Satellite" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Top" Height="38" Width="38" Margin="0,1,0,0"
                        SampleWallpaper="True" ShadowSize="18" Cursor="Hand" Visibility="Collapsed" Opacity="0" AutomationProperties.Name="Island alert">
            <d:GlassSurface.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SatScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="SatShift"/>
                </TransformGroup>
            </d:GlassSurface.RenderTransform>
            <StackPanel x:Name="SatContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                <Border x:Name="SatKey" Visibility="Collapsed" MinWidth="22" Height="19" CornerRadius="5" BorderThickness="1.3" Padding="3,0,3,0"
                        BorderBrush="{DynamicResource T.Text2}" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="SatKeyText" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <Ellipse x:Name="SatKeyLed" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2.5,-2,0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="SatGlyph" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource T.Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SatText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            </StackPanel>
        </d:GlassSurface>

        <d:GlassSurface x:Name="Pill" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Top" Width="220" Height="38" Margin="0,1,0,0"
                        SampleWallpaper="True" ShadowSize="24" Cursor="Hand" AutomationProperties.Name="Dynamic Island" RenderTransformOrigin="0.5,0">
            <d:GlassSurface.RenderTransform>
                <!-- Scale hangs from the top edge: presses squash it, new activities make it bulge like a droplet -->
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PillShift"/>
                    <!-- Moves aside along the edge while a side bubble shows, so the pair stays centred -->
                    <TranslateTransform x:Name="PillSplit"/>
                </TransformGroup>
            </d:GlassSurface.RenderTransform>
            <Grid ClipToBounds="True">
                <!-- Album colours: while a song plays, the glass picks up its artwork's colours. Two layers so one
                     track's colours cross-fade into the next instead of switching. -->
                <Border x:Name="ArtWashA" IsHitTestVisible="False" Opacity="0" CornerRadius="19"/>
                <Border x:Name="ArtWashB" IsHitTestVisible="False" Opacity="0" CornerRadius="19"/>
                <!-- Optional coloured rim (Island settings › Rim); hidden for the plain glass edge -->
                <Border x:Name="PillRim" IsHitTestVisible="False" BorderThickness="1.6" CornerRadius="19" Visibility="Collapsed"/>
                <!-- A soft light that follows the pointer across the glass -->
                <Border x:Name="PillSheen" IsHitTestVisible="False" Opacity="0">
                    <Border.Background>
                        <RadialGradientBrush x:Name="PillSheenBrush" RadiusX="0.32" RadiusY="0.9" Center="0.5,0.3" GradientOrigin="0.5,0.3">
                            <GradientStop Color="#38FFFFFF" Offset="0"/>
                            <GradientStop Color="#0CFFFFFF" Offset="0.55"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============ Collapsed ============ -->
                <StackPanel x:Name="Compact" UseLayoutRounding="True" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0,14,0" Height="38">
                    <!-- Volume HUD: replaces the capsule content for a moment when the volume changes -->
                    <StackPanel x:Name="CHud" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="CHudGlyph" Text="&#xE767;" Style="{StaticResource Icon}" FontSize="14" Width="18" Foreground="{DynamicResource T.Accent}" Margin="0,0,10,0"/>
                        <Grid Width="132" Height="6" VerticalAlignment="Center">
                            <Border CornerRadius="3" Background="{DynamicResource T.Track}"/>
                            <Border x:Name="CHudFill" CornerRadius="3" Background="{DynamicResource T.Accent}" HorizontalAlignment="Left" Width="0"/>
                            <Border CornerRadius="3" Margin="0,0,0,3" Background="#33FFFFFF" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="CHudText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="30" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel x:Name="CPeek" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- Lock keys: a little key cap with an indicator light, like the LED on a keyboard -->
                        <Border x:Name="CPeekKey" Visibility="Collapsed" MinWidth="24" Height="20" CornerRadius="5" BorderThickness="1.3" Padding="4,0,4,0"
                                BorderBrush="{DynamicResource T.Text2}" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="CPeekKeyText" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <Ellipse x:Name="CPeekKeyLed" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2.5,-2,0"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CPeekGlyph" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource T.Accent}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CPeekText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel x:Name="CNormal" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Privacy dots: orange = microphone, green = camera, blue = location in use (like phones) -->
                        <StackPanel x:Name="CPriv" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" Background="Transparent">
                            <Ellipse x:Name="CPrivMic" Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,3,0" Visibility="Collapsed"/>
                            <Ellipse x:Name="CPrivCam" Width="7" Height="7" Fill="#30D158" Margin="0,0,3,0" Visibility="Collapsed"/>
                            <Ellipse x:Name="CPrivLoc" Width="7" Height="7" Fill="#0A84FF" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Microphone pill: an app is using the mic. A mute button, the app, and bars that follow your voice. -->
                        <StackPanel x:Name="CCall" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="CCallMute" Width="24" Height="24" CornerRadius="12" Margin="-4,0,8,0" Cursor="Hand" Background="#33FF9F0A"
                                    ToolTip="Mute the microphone" AutomationProperties.Name="Mute the microphone">
                                <TextBlock x:Name="CCallGlyph" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="12" Foreground="#FF9F0A"/>
                            </Border>
                            <TextBlock x:Name="CCallText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            <d:Equalizer x:Name="CCallEq" Margin="9,0,0,0" External="True"/>
                        </StackPanel>
                        <StackPanel x:Name="CMedia" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="CArt" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource T.AccentSoft}" Margin="0,0,8,0">
                                <TextBlock x:Name="CArtGlyph" Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource T.Accent}"/>
                            </Border>
                            <TextBlock x:Name="CTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            <d:Equalizer x:Name="CEq" Margin="9,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="CTimer" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource T.Accent}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="CTimerText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource T.Accent}"/>
                        </StackPanel>
                        <StackPanel x:Name="CDownload" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource T.Accent}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="CDownloadText" FontSize="12.5" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Ellipse x:Name="CSep" Width="3" Height="3" Fill="{DynamicResource T.Text3}" Margin="11,0,11,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="CSys" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource T.Text2}" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CTime" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CDate" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource T.Text2}" Margin="8,0,0,0"/>
                        <!-- The other glances (IslandWindow.Glance.cs): the status row or the eyes, built on first use -->
                        <StackPanel x:Name="CGlance" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Card: connections, radios, lock keys ============
                     The capsule grows taller and the content nests concentrically inside it: the icon tile's corners
                     are the pill's radius minus the margin, so the gap around it is even all the way round. -->
                <Grid x:Name="Card" UseLayoutRounding="True" Visibility="Collapsed" Opacity="0" Margin="10" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="CardTile" Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="CardTileScale"/></Grid.RenderTransform>
                        <Border x:Name="CardTileFill" CornerRadius="22"/>
                        <!-- a lit upper edge, like light catching the rim of a glass bead -->
                        <Border x:Name="CardTileEdge" CornerRadius="22" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                                    <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#18FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <TextBlock x:Name="CardGlyph" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CardCap" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,14,0">
                        <TextBlock x:Name="CardTitle" FontSize="14.5" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="CardTitleShift"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="CardSub" FontSize="12" Foreground="{DynamicResource T.Text2}" Margin="0,1,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="CardSubShift"/></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <!-- Cards about a file (a screenshot, a finished download) get small buttons here -->
                    <StackPanel x:Name="CardActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed"/>
                    <!-- On/off states get a little switch that flips while you watch -->
                    <Grid x:Name="CardSwitch" Grid.Column="2" Width="40" Height="24" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border x:Name="CardSwitchTrack" CornerRadius="12"/>
                        <Ellipse x:Name="CardKnob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="CardKnobShift"/></Ellipse.RenderTransform>
                            <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" RenderingBias="Performance"/></Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </Grid>

                <!-- ============ Expanded ============ -->
                <Grid x:Name="Expanded" UseLayoutRounding="True" Opacity="0" Visibility="Hidden" Margin="14,10,14,14" Cursor="Arrow" Width="432" Height="266" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Background="{DynamicResource T.Input}" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="1">
                            <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Style="{StaticResource Button.Icon}" Content="&#xE718;" Width="30" Height="30" FontSize="12" ToolTip="Keep open" AutomationProperties.Name="Keep open" Click="OnPin"/>
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" Width="30" Height="30" FontSize="12" ToolTip="Island settings" AutomationProperties.Name="Island settings" Click="OnSettings"/>
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE70E;" Width="30" Height="30" FontSize="12" ToolTip="Collapse (Esc)" AutomationProperties.Name="Collapse" Click="OnCollapseClick"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">

                        <!-- Media -->
                        <Grid x:Name="TabMedia" Visibility="Collapsed">
                            <Grid x:Name="MediaEmpty" Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource T.Text3}"/>
                                    <TextBlock Text="Nothing is playing" Style="{StaticResource Text.Sub}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                                    <TextBlock Text="Start music or a video in any app and it appears here." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="MediaBody">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="MArt" Width="96" Height="96" CornerRadius="16" Background="{DynamicResource T.AccentSoft}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="MArtGlyph" Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource T.Accent}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MSource" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="MTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="46" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="MArtist" Style="{StaticResource Text.Caption}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="MLyric" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource T.Accent}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MPos" Text="0:00" Style="{StaticResource Text.Caption}" FontSize="11" MinWidth="32"/>
                                    <Slider x:Name="MSeek" Grid.Column="1" Minimum="0" Maximum="1" Margin="6,0" VerticalAlignment="Center" AutomationProperties.Name="Position in track"
                                            ValueChanged="OnSeekChanged" Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted"/>
                                    <TextBlock x:Name="MDur" Grid.Column="2" Text="0:00" Style="{StaticResource Text.Caption}" FontSize="11" MinWidth="32" TextAlignment="Right"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="MBack" Style="{StaticResource Button.Icon}" Content="−10" FontFamily="{DynamicResource F.Family}" FontSize="11" FontWeight="SemiBold" ToolTip="Back 10 seconds (←)" AutomationProperties.Name="Back 10 seconds" Click="OnSkipBack"/>
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE892;" ToolTip="Previous" AutomationProperties.Name="Previous track" Click="OnPrev"/>
                                        <Button x:Name="MPlay" Style="{StaticResource Button.IconAccent}" Content="&#xE768;" Width="42" Height="42" FontSize="16" Margin="8,0" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause" Click="OnPlay"/>
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE893;" ToolTip="Next" AutomationProperties.Name="Next track" Click="OnNext"/>
                                        <Button x:Name="MFwd" Style="{StaticResource Button.Icon}" Content="+10" FontFamily="{DynamicResource F.Family}" FontSize="11" FontWeight="SemiBold" ToolTip="Forward 10 seconds" AutomationProperties.Name="Forward 10 seconds" Click="OnSkipForward"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource T.Text2}" Margin="0,0,8,0"/>
                                        <Slider x:Name="MVolume" Width="100" Minimum="0" Maximum="100" AutomationProperties.Name="Volume" ValueChanged="OnVolumeSlider"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- System -->
                        <UniformGrid x:Name="TabSystem" Columns="3" Rows="2" Visibility="Collapsed"/>

                        <!-- Quick controls -->
                        <Grid x:Name="TabControls" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="QMute" Style="{StaticResource Button.Icon}" Content="&#xE767;" ToolTip="Mute" AutomationProperties.Name="Mute" Click="OnMute"/>
                                <Slider x:Name="QVolume" Grid.Column="1" Minimum="0" Maximum="100" Margin="6,0" AutomationProperties.Name="Volume" ValueChanged="OnVolumeSlider"/>
                                <TextBlock x:Name="QVolumeText" Grid.Column="2" Style="{StaticResource Text.Caption}" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Button x:Name="QMixerButton" Grid.Column="3" Style="{StaticResource Button.Icon}" Content="&#xE9E9;" ToolTip="Volume by app" AutomationProperties.Name="Volume by app" Click="OnMixerButton"/>
                            </Grid>
                            <Grid x:Name="QBrightnessRow" Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="15"/>
                                <Slider x:Name="QBrightness" Grid.Column="1" Minimum="0" Maximum="100" Margin="6,0" AutomationProperties.Name="Brightness" ValueChanged="OnBrightnessSlider"/>
                                <TextBlock x:Name="QBrightnessText" Grid.Column="2" Style="{StaticResource Text.Caption}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <UniformGrid x:Name="QShortcuts" Grid.Row="2" Columns="4" Margin="-3,8,-3,0" VerticalAlignment="Top"/>
                            <!-- Volume by app: replaces the tiles while open -->
                            <ScrollViewer x:Name="QMixerScroll" Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="QMixer"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Focus -->
                        <Grid x:Name="TabFocus" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                <d:Ring x:Name="FRing" Thickness="7"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FTime" Text="25:00" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FMode" Text="Focus" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource T.Input}" CornerRadius="10" Padding="1" HorizontalAlignment="Left">
                                    <StackPanel x:Name="FModes" Orientation="Horizontal"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="FStart" Style="{StaticResource Button.Accent}" Content="Start" MinWidth="86" Click="OnFocusToggle"/>
                                    <Button Content="Reset" Margin="8,0,0,0" Click="OnFocusReset"/>
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE738;" Margin="8,0,0,0" ToolTip="5 minutes less" AutomationProperties.Name="Five minutes less" Click="OnFocusLess"/>
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE710;" ToolTip="5 minutes more" AutomationProperties.Name="Five minutes more" Click="OnFocusMore"/>
                                </StackPanel>
                                <TextBlock x:Name="FStats" Style="{StaticResource Text.Caption}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Calendar -->
                        <Grid x:Name="TabCalendar" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- The picked day: its date, its events, and a line to add one -->
                            <Grid Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CalDay" Style="{StaticResource Text.Label}" Foreground="{DynamicResource T.Accent}" FontSize="11.5"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="CalNumber" FontSize="40" FontWeight="SemiBold" Margin="-2,-5,10,-5" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="CalMonth" Style="{StaticResource Text.Muted}"/>
                                        <TextBlock x:Name="CalWeek" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CalEvents"/>
                                </ScrollViewer>
                                <Border Grid.Row="3" Style="{StaticResource Card.Inset}" Padding="10,5" Margin="0,6,0,0">
                                    <Grid>
                                        <TextBlock x:Name="CalAddHint" Text="Add… e.g. 9:30 Stand-up" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource T.Text3}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CalAdd" Style="{StaticResource TextBox.Bare}" AutomationProperties.Name="Add an event" MaxLength="80"
                                                 PreviewMouseDown="OnNotesMouseDown" TextChanged="OnCalAddChanged" KeyDown="OnCalAddKey"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <d:MonthView x:Name="CalView" Grid.Column="1" CellSize="25"/>
                        </Grid>

                        <!-- Weather (built in code: the off state, or now / next hours / next days) -->
                        <Grid x:Name="TabWeather" Visibility="Collapsed"/>

                        <!-- Coding agents (built in code; only when coding agents are on) -->
                        <Grid x:Name="TabAgents" Visibility="Collapsed"/>

                        <!-- Notes -->
                        <Grid x:Name="TabNotes" Visibility="Collapsed">
                            <Border Style="{StaticResource Card.Inset}" Padding="12,10">
                                <Grid>
                                    <TextBlock x:Name="NotesHint" Text="Quick note… saved on this PC only." Style="{StaticResource Text.Caption}" FontSize="13" Foreground="{DynamicResource T.Text3}" IsHitTestVisible="False"/>
                                    <TextBox x:Name="NotesBox" Style="{StaticResource TextBox.Bare}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Quick note" TextChanged="OnNotesChanged" PreviewMouseDown="OnNotesMouseDown"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Clipboard history -->
                        <Grid x:Name="TabClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,0,8">
                                <TextBlock x:Name="ClipHeader" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                <Button x:Name="ClipClear" Content="Clear" HorizontalAlignment="Right" Padding="12,4" FontSize="12" Click="OnClipClear"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ClipList"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- File shelf -->
                        <Grid x:Name="TabShelf" Visibility="Collapsed" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,0,8">
                                <TextBlock x:Name="ShelfHeader" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                <Button Content="Clear" HorizontalAlignment="Right" Padding="12,4" FontSize="12" Click="OnShelfClear"/>
                            </Grid>
                            <Border Grid.Row="1" x:Name="ShelfZone" CornerRadius="14" BorderThickness="1.5" BorderBrush="{DynamicResource T.Stroke}" Background="{DynamicResource T.Input}">
                                <Grid>
                                    <StackPanel x:Name="ShelfEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource T.Text3}"/>
                                        <TextBlock Text="Drop files here to keep them handy" Style="{StaticResource Text.Sub}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                        <TextBlock Text="Then drag them out into any app or folder. Files stay where they are." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6">
                                        <WrapPanel x:Name="ShelfList"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </d:GlassSurface>
    </Grid>
</Window>
